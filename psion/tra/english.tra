@0 = ~Experimental D&D 3.5e Psion class for GemRB~
@1 = ~Run GemRB against this game before installing; gemrb_path.txt is missing.~
@2 = ~This component supports Tutu, Tutu_TotSC, BGEE, Classic Adventures, BGT, BG2EE and EET.~
@3 = ~Could not determine the active GemRB class identifier range.~
@4 = ~Unsupported CLASTEXT.2DA layout.~
@5 = ~Unsupported CLSKILLS.2DA layout.~
@6 = ~Six consecutive free class identifiers are not available.~
@100 = ~seer~
@101 = ~PSION — SEER:~
@102 = ~Seer Psion specializing in Clairsentience. Uses Intelligence, a shared point pool, spontaneous powers, d4 hit points, no armor and any alignment. Uses Mage saving throws with a +2 bonus against wands and spells.~
@103 = ~shaper~
@104 = ~PSION — SHAPER:~
@105 = ~Shaper Psion specializing in Metacreativity. Uses Intelligence, a shared point pool, spontaneous powers, d4 hit points, no armor and any alignment. Uses Mage saving throws with a +2 bonus against wands and spells.~
@106 = ~kineticist~
@107 = ~PSION — KINETICIST:~
@108 = ~Kineticist Psion specializing in Psychokinesis. Uses Intelligence, a shared point pool, spontaneous powers, d4 hit points, no armor and any alignment. Uses Mage saving throws with a +2 bonus against wands and spells.~
@109 = ~egoist~
@110 = ~PSION — EGOIST:~
@111 = ~Egoist Psion specializing in Psychometabolism. Uses Intelligence, a shared point pool, spontaneous powers, d4 hit points, no armor and any alignment. Uses Mage saving throws with a +2 bonus against wands and spells.~
@112 = ~nomad~
@113 = ~PSION — NOMAD:~
@114 = ~Nomad Psion specializing in Psychoportation. Uses Intelligence, a shared point pool, spontaneous powers, d4 hit points, no armor and any alignment. Uses Mage saving throws with a +2 bonus against wands and spells.~
@115 = ~telepath~
@116 = ~PSION — TELEPATH:~
@117 = ~Telepath Psion specializing in Telepathy. Uses Intelligence, a shared point pool, spontaneous powers, d4 hit points, no armor and any alignment. Uses Mage saving throws with a +2 bonus against wands and spells.~

@200 = ~Cognizance Crystal~
@201 = ~This attuned crystal increases a Psion's maximum power-point capacity by 10 while equipped. Equipping it does not restore spent power points; removing it can reduce and clamp the current pool to the lower maximum.~
@202 = ~Crystal of Centering~
@203 = ~This resonant crystal grants a +2 bonus to Concentration checks while equipped.~
@204 = ~Focus Prism~
@205 = ~This prism grants a +2 bonus to Self-Discipline checks while the wearer is psionically focused. It does not grant or restore focus.~
@206 = ~Shaper's Prism~
@207 = ~Usable only by Shapers. This metacreative prism grants a +3 bonus to Ectoplasmic Craft checks while equipped.~
@208 = ~Lens of Exacting Thought~
@209 = ~This lens increases the saving throw DC of the wearer's Psion powers by 1 while equipped. The bonus uses the same exact-current-Intelligence power variants as ordinary manifestation.~
