LAF psion_prepare_equipment_item
  INT_VAR ps_item_class = ps_nomad_id ps_item_price = 10000
  STR_VAR
    ps_item_source = ~BOOT01~
    ps_item_resref = ~PSIITM05~
    ps_item_name = ~Nomad's Striders~
