LAF psion_prepare_equipment_item
  INT_VAR ps_item_class = ps_telepath_id ps_item_price = 12000
  STR_VAR
    ps_item_source = ~HELM01~
    ps_item_resref = ~PSIITM06~
    ps_item_name = ~Whispering Circlet~
    ps_item_description = ~A Telepath wearing this circlet hears hostile intent before it fully forms. Only a Telepath can use it. Intelligence increases by 1 and saving throws vs spells improve by 1.~
END
COPY_EXISTING ~PSIITM06.ITM~ ~override~
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 19 target = 1 timing = 2 parameter1 = 1 END
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 37 target = 1 timing = 2 parameter1 = (0 - 1) END
BUT_ONLY
