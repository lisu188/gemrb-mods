// Mind Thrust and Vigor augmentation variants.
//
// Like Energy Ray, each learned parent becomes an opcode-214 selector. The
// chosen child resource carries its total PP cost in PSIONAUGMENT.2DA.

DEFINE_ACTION_FUNCTION psion_create_mind_thrust_variant
INT_VAR
  ps_cost = 1
STR_VAR
  ps_resref = ~~
BEGIN
  // Mind Thrust's own augment line improves the save DC by 1 for each extra
  // 2d10, on top of the level-1 baseline every generated power carries. These
  // children replace PS1MTHR.spl outright, so the baseline has to be added
  // here explicitly rather than inherited from the level-1 builder.
  OUTER_SET ps_save_penalty = (psion_level1_save_penalty - ((ps_cost - 1) / 2))
  OUTER_SPRINT ps_variant_name ~Mind Thrust (%ps_cost% PP)~
  OUTER_SPRINT ps_variant_description ~A direct mental attack deals %ps_cost%d10 magical damage. A save vs spell negates the damage; the save penalty improves by 1 for every 2 PP beyond the first.~

  LAF psion_create_level1_power
    INT_VAR
      ps_target = 2
      ps_range = 30
      ps_projectile = psion_none_projectile
      ps_flags = psion_hostile_flags
    STR_VAR
      ps_resref = ~%ps_resref%~
      ps_name = ~%ps_variant_name%~
      ps_description = ~%ps_variant_description%~
      ps_icon = ~spwi105~
  END

  COPY_EXISTING ~%ps_resref%.spl~ ~override~
    LPF ADD_SPELL_EFFECT
      INT_VAR
        opcode = 12
        target = 2
        resist_dispel = BIT0
        parameter2 = IDS_OF_SYMBOL (~dmgtype~ ~MAGIC~)
        dicenumber = ps_cost
        dicesize = 10
        savingthrow = BIT0
        savebonus = ps_save_penalty
    END
  BUT_ONLY
END

DEFINE_ACTION_FUNCTION psion_create_vigor_variant
INT_VAR
  ps_cost = 1
STR_VAR
  ps_resref = ~~
BEGIN
  OUTER_SET ps_vigor_hp = (ps_cost * 5)
  OUTER_SPRINT ps_variant_name ~Vigor (%ps_cost% PP)~
  OUTER_SPRINT ps_variant_description ~The manifester gains %ps_vigor_hp% temporary-hit-point-equivalent points for one turn. A new Vigor replaces every existing Vigor variant.~

  LAF psion_create_level1_power
    STR_VAR
      ps_resref = ~%ps_resref%~
      ps_name = ~%ps_variant_name%~
      ps_description = ~%ps_variant_description%~
      ps_icon = ~sppr103~
  END

  COPY_EXISTING ~%ps_resref%.spl~ ~override~
    // Remove effects from every possible Vigor variant before applying this
    // one, so changing augmentation refreshes the pool rather than stacking it.
    // This has to cover the whole ladder, not just the first nine tiers, or a
    // higher-PP Vigor would stack on top of a lower one already running.
    FOR (ps_strip_cost = 1; ps_strip_cost <= psion_max_augment_cost; ++ps_strip_cost) BEGIN
      PATCH_IF (ps_strip_cost < 10) BEGIN
        SPRINT ps_strip_index ~0%ps_strip_cost%~
      END ELSE BEGIN
        SPRINT ps_strip_index ~%ps_strip_cost%~
      END
      LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 resist_dispel = BIT1 STR_VAR resource = ~PSVG%ps_strip_index%~ END
    END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 18 target = 1 resist_dispel = BIT1 parameter1 = ps_vigor_hp timing = 0 duration = 60 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 17 target = 1 parameter1 = ps_vigor_hp timing = 1 END
  BUT_ONLY
END

// Parent selectors are free. Their chosen child resources perform the actual
// manifestation and PP transaction.
DELETE ~override/PS1MTHR.spl~
LAF psion_create_level1_power
  STR_VAR
    ps_resref = ~PS1MTHR~
    ps_name = ~Mind Thrust~
    ps_description = ~Spend power points up to your manifester level. Damage is 1d10 per PP and the save DC increases for every 2 additional PP.~
    ps_icon = ~spwi105~
END
COPY_EXISTING ~PS1MTHR.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 214 target = 1 timing = 1 STR_VAR resource = ~PS1MTHR~ END
BUT_ONLY

DELETE ~override/PS1VIGR.spl~
LAF psion_create_level1_power
  STR_VAR
    ps_resref = ~PS1VIGR~
    ps_name = ~Vigor~
    ps_description = ~Spend power points up to your manifester level to gain 5 temporary-hit-point-equivalent points per PP for one turn.~
    ps_icon = ~sppr103~
END
COPY_EXISTING ~PS1VIGR.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 214 target = 1 timing = 1 STR_VAR resource = ~PS1VIGR~ END
BUT_ONLY


// Both ladders run from 1 PP to psion_max_augment_cost. PSIONAUGMENT.2DA and
// the selector tables are produced from the same ceiling by
// psion/tools/generate_augment_tables.py. Resrefs are zero padded to two
// digits; OUTER_SPRINT has no printf padding, hence the explicit branch.
OUTER_FOR (ps_ladder_cost = 1; ps_ladder_cost <= psion_max_augment_cost; ++ps_ladder_cost) BEGIN
  OUTER_SPRINT ps_ladder_index ~%ps_ladder_cost%~
  ACTION_IF (ps_ladder_cost < 10) BEGIN
    OUTER_SPRINT ps_ladder_index ~0%ps_ladder_cost%~
  END

  LAF psion_create_mind_thrust_variant
    INT_VAR
      ps_cost = ps_ladder_cost
    STR_VAR
      ps_resref = ~PSMT%ps_ladder_index%~
  END

  LAF psion_create_vigor_variant
    INT_VAR
      ps_cost = ps_ladder_cost
    STR_VAR
      ps_resref = ~PSVG%ps_ladder_index%~
  END
END
