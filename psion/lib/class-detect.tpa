// Allocate six consecutive class IDs above every class already registered by
// the game or earlier mods. GemRB's normalized split CLASTEXT layout has six
// fields including the row label, while native Enhanced Edition tables have ten.
// Do not use COUNT_2DA_COLS here: some GemRB tables end with explanatory # lines
// containing more tokens than the real header.
OUTER_SET ps_max_id = (0 - 1)
OUTER_SET ps_split = 0
OUTER_SET ps_text_cols = 0

ACTION_IF FILE_EXISTS_IN_GAME ~hpclass.2da~ THEN BEGIN
  OUTER_SET ps_split = 1

  COPY_EXISTING ~clastext.2da~ ~override~
    // BIOGRAPHY is unique to the native EE layout. INDEX_BUFFER inspects the
    // active game resource, so this also works when CLASTEXT is stored in a BIF.
    SET ps_detect_cols = 6
    PATCH_IF (INDEX_BUFFER (~BIOGRAPHY~) >= 0) BEGIN
      SET ps_detect_cols = 10
    END
    INNER_ACTION BEGIN
      OUTER_SET ps_text_cols = %ps_detect_cols%
    END

    COUNT_2DA_ROWS ps_detect_cols ps_text_rows

    // COUNT_2DA_ROWS may include long trailing comments. They are harmless:
    // only numeric CLASSID values from column 1 participate in the maximum.
    FOR (ps_i = 0; ps_i < ps_text_rows; ++ps_i) BEGIN
      READ_2DA_ENTRY ps_i 1 ps_detect_cols ps_id
      PATCH_IF IS_AN_INT ~%ps_id%~ AND ps_id > ps_max_id BEGIN
        SET ps_max_id = ps_id
        INNER_ACTION BEGIN
          OUTER_SET ps_max_id = %ps_id%
        END
      END
    END
  BUT_ONLY
END ELSE BEGIN
  // Legacy GemRB stores the class identifier in data column 6 of the combined
  // nineteen-field CLASSES.2DA table.
  COPY_EXISTING ~classes.2da~ ~override~
    SET ps_detect_cols = 19
    COUNT_2DA_ROWS ps_detect_cols ps_class_rows
    FOR (ps_i = 0; ps_i < ps_class_rows; ++ps_i) BEGIN
      READ_2DA_ENTRY ps_i 6 ps_detect_cols ps_id
      PATCH_IF IS_AN_INT ~%ps_id%~ AND ps_id > ps_max_id BEGIN
        SET ps_max_id = ps_id
        INNER_ACTION BEGIN
          OUTER_SET ps_max_id = %ps_id%
        END
      END
    END
  BUT_ONLY
END

ACTION_IF ps_max_id < 0 THEN BEGIN FAIL @3 END

// Infinity Engine class identifiers are one byte. Reserve room for all six
// disciplines before committing any table changes.
ACTION_IF ps_max_id > 249 THEN BEGIN FAIL @6 END

OUTER_SET ps_seer_id = ps_max_id + 1
OUTER_SET ps_shaper_id = ps_max_id + 2
OUTER_SET ps_kineticist_id = ps_max_id + 3
OUTER_SET ps_egoist_id = ps_max_id + 4
OUTER_SET ps_nomad_id = ps_max_id + 5
OUTER_SET ps_telepath_id = ps_max_id + 6
