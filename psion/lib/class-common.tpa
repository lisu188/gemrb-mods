// Build the Psion proficiency column from WEAPPROF row names instead of a
// positional literal. BG-family tables can be extended or reordered by other
// mods; row-name mapping keeps the intended one-pip weapon list stable.
OUTER_SET ps_weapprof_valid = 0
OUTER_SPRINT ps_weapprof_values ~~

COPY_EXISTING ~weapprof.2da~ ~override~
  COUNT_2DA_COLS ps_weapprof_cols
  COUNT_2DA_ROWS ps_weapprof_cols ps_weapprof_rows
  PATCH_IF (ps_weapprof_cols >= 2) AND (ps_weapprof_rows > 0) BEGIN
    SPRINT ps_values ~~
    FOR (ps_i = 0; ps_i < ps_weapprof_rows; ++ps_i) BEGIN
      READ_2DA_ENTRY ps_i 0 ps_weapprof_cols ps_prof_name
      SET ps_prof_max = 0
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~DAGGER~ BEGIN SET ps_prof_max = 1 END
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~CLUB~ BEGIN SET ps_prof_max = 1 END
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~SPEAR~ BEGIN SET ps_prof_max = 1 END
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~QUARTERSTAFF~ BEGIN SET ps_prof_max = 1 END
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~CROSSBOW~ BEGIN SET ps_prof_max = 1 END
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~DART~ BEGIN SET ps_prof_max = 1 END
      PATCH_IF ~%ps_prof_name%~ STRING_EQUAL_CASE ~SLING~ BEGIN SET ps_prof_max = 1 END
      SPRINT ps_values ~%ps_values% %ps_prof_max%~
    END
    INNER_ACTION BEGIN
      OUTER_SPRINT ps_weapprof_values ~%ps_values%~
      OUTER_SET ps_weapprof_valid = 1
    END
  END
BUT_ONLY

ACTION_IF ps_weapprof_valid != 1 THEN BEGIN
  FAIL ~The Psion mod could not map WEAPPROF.2DA proficiency rows.~
END

// ABCLASRQ is the chargen minimum-ability table. Psions require Intelligence
// 15; all other ability minima remain unrestricted by the class itself.
OUTER_SET ps_abclasrq_valid = 0
COPY_EXISTING ~abclasrq.2da~ ~override~
  COUNT_2DA_COLS ps_abclasrq_cols
  PATCH_IF ps_abclasrq_cols = 7 BEGIN
    INNER_ACTION BEGIN
      OUTER_SET ps_abclasrq_valid = 1
    END
  END
BUT_ONLY

ACTION_IF ps_abclasrq_valid != 1 THEN BEGIN
  FAIL ~The Psion mod requires the standard six-ability ABCLASRQ.2DA layout.~
END

APPEND ~class.ids~ ~%ps_seer_id% PSION_SEER~ UNLESS ~PSION_SEER~
APPEND ~alignmnt.2da~ ~PSION_SEER 1 1 1 1 1 1 1 1 1~ UNLESS ~PSION_SEER~
APPEND ~abclasrq.2da~ ~PSION_SEER 0 0 0 15 0 0~ UNLESS ~PSION_SEER~
APPEND_COL ~weapprof.2da~ ~$ $ PSION_SEER%ps_weapprof_values%~ UNLESS ~PSION_SEER~
APPEND ~profs.2da~ ~PSION_SEER 2 4~ UNLESS ~PSION_SEER~
APPEND ~xpcap.2da~ ~PSION_SEER 8000000~ UNLESS ~PSION_SEER~
APPEND ~avprefc.2da~ ~PSION_SEER 0x600~ UNLESS ~PSION_SEER~
APPEND ~qslots.2da~ ~PSION_SEER 0 3 4 2 8 9 11 12 13~ UNLESS ~PSION_SEER~
