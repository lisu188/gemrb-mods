// Psionic focus and runtime-backed bonus feats.
//
// Focus and feat ownership live in save-serialized GemRB actor effects. These
// SPLs provide action-bar/selector resources; Psionics.py performs prerequisite
// checks and irreversible selection changes. Center Mind writes focus only from
// the resolving SPL, so interruption/cancellation never restores it early.
// PX-prefixed resources stay outside the PS power namespace.

DEFINE_ACTION_FUNCTION psion_create_focus_action
INT_VAR
  ps_speed = 0
STR_VAR
  ps_resref = ~~
  ps_name = ~~
  ps_description = ~~
  ps_icon = ~sppr101~
BEGIN
  CREATE ~spl~ ~%ps_resref%~
  COPY_EXISTING ~%ps_resref%.spl~ ~override~
    SAY NAME1 ~%ps_name%~
    WRITE_LONG NAME2 0xffffffff
    SAY UNIDENTIFIED_DESC ~%ps_description%~
    WRITE_LONG DESC 0xffffffff
    WRITE_SHORT 0x1c 4
    WRITE_LONG 0x18 (BIT14 BOR BIT25)
    WRITE_LONG 0x34 1
    WRITE_ASCII 0x3a ~%ps_icon%C~ #8
    LPF ADD_SPELL_HEADER
      INT_VAR target = 5 range = 0x7fff speed = ps_speed projectile = 1
      STR_VAR icon = ~%ps_icon%B~
    END
  BUT_ONLY
END

// Keep this marker synchronized with FOCUS_EFFECT_MARKER in Psionics.py.
OUTER_SET psion_focus_state_marker = 0x50534643

// Normal focus recovery: a full-round approximation. Runtime performs the
// Concentration DC 20 authorization; this SPL applies focus only on resolution.
LAF psion_create_focus_action
  INT_VAR ps_speed = 9
  STR_VAR
    ps_resref = ~PXCNTR~
    ps_name = ~Center Mind~
    ps_description = ~Spend a full-round action centering your thoughts to regain psionic focus. Requires at least 1 power point and a successful Concentration check against DC 20.~
    ps_icon = ~sppr101~
END
COPY_EXISTING ~PXCNTR.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 206 target = 1 resist_dispel = BIT1 parameter1 = 1 parameter2 = psion_focus_state_marker timing = 9 STR_VAR resource = ~PSFOCUS~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 1 resist_dispel = BIT1 parameter1 = 0 parameter2 = 1 timing = 1 STR_VAR resource = ~PXFSPED~ END
BUT_ONLY

// Psionic Meditation replaces the normal Center Mind action with this faster
// half-round approximation of a tabletop move action. The DC and resolution
// semantics remain identical to ordinary Center Mind.
LAF psion_create_focus_action
  INT_VAR ps_speed = 5
  STR_VAR
    ps_resref = ~PXCMEDI~
    ps_name = ~Center Mind (Meditation)~
    ps_description = ~Psionic Meditation lets you regain focus as a move-action approximation. Requires at least 1 power point and a successful Concentration check against DC 20.~
    ps_icon = ~sppr101~
END
COPY_EXISTING ~PXCMEDI.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 206 target = 1 resist_dispel = BIT1 parameter1 = 1 parameter2 = psion_focus_state_marker timing = 9 STR_VAR resource = ~PSFOCUS~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 1 resist_dispel = BIT1 parameter1 = 0 parameter2 = 1 timing = 1 STR_VAR resource = ~PXFSPED~ END
BUT_ONLY

// The selector itself is learned once at level 1. Psionics.py derives earned
// bonus-feat credits from class level (1, 5, 10, 15 and 20) and recharges this
// same selector only while an unspent credit remains.
LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFSEL~
    ps_name = ~Bonus Psionic Feat~
    ps_description = ~Spend one earned Psion bonus-feat choice. New choices become available at Psion levels 1, 5, 10, 15, and 20. Psionic Talent may be selected more than once; nonrepeatable feats disappear once learned. Canceling the selector does not consume the choice.~
    ps_icon = ~sppr107~
END
COPY_EXISTING ~PXFSEL.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 214 target = 1 timing = 1 STR_VAR resource = ~PSFSEL~ END
BUT_ONLY

// Powers-known credits are derived from PSIONKNOWN.2DA. The selector is
// reusable while a legal unlearned power remains; PXL* choices are harmless
// proxies that Psionics.py commits into real known powers.
LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXPLRN~
    ps_name = ~Learn Psion Power~
    ps_description = ~Choose one Psion power to learn. Available choices respect your powers-known total, maximum power level, and discipline. Selecting a choice learns it permanently but does not manifest it or spend power points.~
    ps_icon = ~spwi112~
END
COPY_EXISTING ~PXPLRN.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 214 target = 1 timing = 1 STR_VAR resource = ~PSPICK~ END
BUT_ONLY

LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFTALT~
    ps_name = ~Psionic Talent~
    ps_description = ~Increase your power-point reserve. The first selection grants 2 power points; each later selection grants 1 more point than the previous selection. This feat may be selected repeatedly.~
    ps_icon = ~sppr412~
END

LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFBODY~
    ps_name = ~Psionic Body~
    ps_description = ~Gain 2 hit points for every psionic feat you have, including this one. Each psionic feat selected later grants 2 additional hit points.~
    ps_icon = ~sppr309~
END

LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFSPD~
    ps_name = ~Speed of Thought~
    ps_description = ~Requires Wisdom 13. While psionically focused, your movement rate increases by approximately one third, representing the tabletop +10-foot insight bonus to a 30-foot base speed.~
    ps_icon = ~spwi305~
END

LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFMEDI~
    ps_name = ~Psionic Meditation~
    ps_description = ~Requires Wisdom 13 and 7 ranks in Concentration. You can regain psionic focus using the faster Center Mind (Meditation) action instead of the normal full-round action.~
    ps_icon = ~sppr101~
END

// Dedicated helper resources keep Speed of Thought isolated from haste, slow,
// Burst, and third-party movement effects.
LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFSPED~
    ps_name = ~Speed of Thought: Focused~
    ps_description = ~Internal Psion focus helper.~
    ps_icon = ~spwi305~
END
COPY_EXISTING ~PXFSPED.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 resist_dispel = BIT1 STR_VAR resource = ~PXFSPED~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 126 target = 1 resist_dispel = BIT1 parameter1 = 133 parameter2 = 2 timing = 9 END
BUT_ONLY

LAF psion_create_focus_action
  STR_VAR
    ps_resref = ~PXFSPOF~
    ps_name = ~Speed of Thought: Unfocused~
    ps_description = ~Internal Psion focus helper.~
    ps_icon = ~spwi305~
END
COPY_EXISTING ~PXFSPOF.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 resist_dispel = BIT1 STR_VAR resource = ~PXFSPED~ END
BUT_ONLY
