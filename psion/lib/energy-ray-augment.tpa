// Energy Ray augmentation vertical slice.
//
// The learned PS1ERAY resource becomes an opcode-214 selector. Each selected
// subspell is a real power resource whose total PP cost is defined in
// PSIONAUGMENT.2DA and enforced by Psionics.py. Damage dice equal total PP,
// subject to the normal manifester-level cap.

DEFINE_ACTION_FUNCTION psion_create_energy_ray_variant
INT_VAR
  ps_cost = 1
  ps_damage_type = 0
  ps_dice_size = 6
  ps_flat_bonus = 0
STR_VAR
  ps_resref = ~~
  ps_energy_name = ~~
  ps_icon = ~spwi112~
BEGIN
  OUTER_SPRINT ps_variant_name ~Energy Ray: %ps_energy_name% (%ps_cost% PP)~
  OUTER_SPRINT ps_variant_description ~A %ps_energy_name% ray deals %ps_cost%d%ps_dice_size% damage. Total PP spent is limited by manifester level.~

  LAF psion_create_level1_power
    INT_VAR
      ps_target = 2
      ps_range = 30
      ps_projectile = psion_none_projectile
      ps_flags = psion_hostile_flags
    STR_VAR
      ps_resref = ~%ps_resref%~
      ps_name = ~%ps_variant_name%~
      ps_description = ~%ps_variant_description%~
      ps_icon = ~%ps_icon%~
  END

  COPY_EXISTING ~%ps_resref%.spl~ ~override~
    LPF ADD_SPELL_EFFECT
      INT_VAR
        opcode = 12
        target = 2
        resist_dispel = BIT0
        parameter2 = ps_damage_type
        dicenumber = ps_cost
        dicesize = ps_dice_size
    END
    PATCH_IF ps_flat_bonus > 0 BEGIN
      // Fire follows the 3e energy-power rider: +1 damage per die.
      LPF ADD_SPELL_EFFECT
        INT_VAR
          opcode = 12
          target = 2
          resist_dispel = BIT0
          parameter1 = ps_cost
          parameter2 = ps_damage_type
      END
    END
  BUT_ONLY
END

// Replace the non-augmented base resource with a variant selector. Selectors
// are free; only the chosen child resource reserves and spends PP.
DELETE ~override/PS1ERAY.spl~
LAF psion_create_level1_power
  STR_VAR
    ps_resref = ~PS1ERAY~
    ps_name = ~Energy Ray~
    ps_description = ~Choose an energy type and spend power points up to your manifester level. Damage dice equal total PP spent.~
    ps_icon = ~spwi112~
END
COPY_EXISTING ~PS1ERAY.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 214 target = 1 timing = 1 STR_VAR resource = ~PS1ERAY~ END
BUT_ONLY

// Each energy ladder runs from 1 PP to the manifester-level ceiling defined by
// psion_max_augment_cost, so a high-level Psion can spend up to their level on
// a single ray as the tabletop rules allow. The four energy definitions stay
// explicit because they differ in damage type, die size, the fire rider and
// icon; only the per-cost rows are generated.
//
// PSIONAUGMENT.2DA and PS1ERAY.2DA are produced from the same ceiling by
// psion/tools/generate_augment_tables.py. Resrefs are zero padded to two
// digits; OUTER_SPRINT has no printf padding, hence the explicit branch.
DEFINE_ACTION_FUNCTION psion_build_energy_ray_ladder
INT_VAR
  ps_damage_type = 0
  ps_dice_size = 6
  ps_flat_bonus = 0
STR_VAR
  ps_prefix = ~~
  ps_energy_name = ~~
  ps_icon = ~spwi112~
BEGIN
  OUTER_FOR (ps_ladder_cost = 1; ps_ladder_cost <= psion_max_augment_cost; ++ps_ladder_cost) BEGIN
    OUTER_SPRINT ps_ladder_index ~%ps_ladder_cost%~
    ACTION_IF (ps_ladder_cost < 10) BEGIN
      OUTER_SPRINT ps_ladder_index ~0%ps_ladder_cost%~
    END
    LAF psion_create_energy_ray_variant
      INT_VAR
        ps_cost = ps_ladder_cost
        ps_damage_type = ps_damage_type
        ps_dice_size = ps_dice_size
        ps_flat_bonus = ps_flat_bonus
      STR_VAR
        ps_resref = ~%ps_prefix%%ps_ladder_index%~
        ps_energy_name = ~%ps_energy_name%~
        ps_icon = ~%ps_icon%~
    END
  END
END

LAF psion_build_energy_ray_ladder
  INT_VAR
    ps_damage_type = IDS_OF_SYMBOL (~dmgtype~ ~FIRE~)
    ps_dice_size = 6
    ps_flat_bonus = 1
  STR_VAR
    ps_prefix = ~PSRF~
    ps_energy_name = ~Fire~
    ps_icon = ~spwi103~
END

LAF psion_build_energy_ray_ladder
  INT_VAR
    ps_damage_type = IDS_OF_SYMBOL (~dmgtype~ ~COLD~)
    ps_dice_size = 6
  STR_VAR
    ps_prefix = ~PSRC~
    ps_energy_name = ~Cold~
    ps_icon = ~spwi202~
END

LAF psion_build_energy_ray_ladder
  INT_VAR
    ps_damage_type = IDS_OF_SYMBOL (~dmgtype~ ~ELECTRICITY~)
    ps_dice_size = 6
  STR_VAR
    ps_prefix = ~PSRE~
    ps_energy_name = ~Electricity~
    ps_icon = ~spwi113~
END

LAF psion_build_energy_ray_ladder
  INT_VAR
    ps_damage_type = IDS_OF_SYMBOL (~dmgtype~ ~MAGIC~)
    ps_dice_size = 4
  STR_VAR
    ps_prefix = ~PSRS~
    ps_energy_name = ~Sonic~
    ps_icon = ~spwi212~
END
