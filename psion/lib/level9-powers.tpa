// Purpose-built level-9 Psion discipline powers.

DEFINE_ACTION_FUNCTION psion_create_level9_power
INT_VAR
  ps_target = 5
  ps_range = 0x7fff
  ps_speed = 9
  ps_projectile = 1
  ps_flags = (BIT14 BOR BIT25)
STR_VAR
  ps_resref = ~~
  ps_name = ~~
  ps_description = ~~
  ps_icon = ~spwi903~
BEGIN
  CREATE ~spl~ ~%ps_resref%~
  COPY_EXISTING ~%ps_resref%.spl~ ~override~
    SAY NAME1 ~%ps_name%~
    WRITE_LONG NAME2 0xffffffff
    SAY UNIDENTIFIED_DESC ~%ps_description%~
    WRITE_LONG DESC 0xffffffff
    WRITE_SHORT 0x1c 4
    WRITE_LONG 0x18 ps_flags
    WRITE_LONG 0x34 9
    WRITE_ASCII 0x3a ~%ps_icon%C~ #8
    LPF ADD_SPELL_HEADER
      INT_VAR
        target = ps_target
        range = ps_range
        speed = ps_speed
        projectile = ps_projectile
      STR_VAR
        icon = ~%ps_icon%B~
    END
  BUT_ONLY
END

OUTER_SET psion_level9_hostile_flags = (BIT9 BOR BIT10 BOR BIT14 BOR BIT25)
OUTER_SET psion_level9_save_penalty = (psion_key_ability_save_penalty - 8)

// Metafaculty is a remote information-gathering power. Without a campaign-wide
// creature database exposed to SPL effects, the portable form maximizes local
// perception rather than inventing facts about off-map actors.
LAF psion_create_level9_power
  STR_VAR
    ps_resref = ~PS9META~
    ps_name = ~Metafaculty~
    ps_description = ~For five rounds the Seer gains supernatural local perception: detects invisible creatures, cannot be backstabbed, gains +100 trap detection, +6 Armor Class, and +6 to all saving throws. Tabletop Metafaculty reveals detailed facts and location for a known creature anywhere; portable SPL resources cannot query arbitrary off-map campaign actors.~
    ps_icon = ~sppr909~
END
COPY_EXISTING ~PS9META.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 resist_dispel = BIT1 STR_VAR resource = ~PS9META~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 193 target = 1 resist_dispel = BIT1 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 292 target = 1 resist_dispel = BIT1 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 91 target = 1 resist_dispel = BIT1 parameter1 = 100 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 1 resist_dispel = BIT1 parameter1 = (0 - 6) timing = 0 duration = 30 END
  FOR (ps_save_opcode = 33; ps_save_opcode <= 37; ++ps_save_opcode) BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = ps_save_opcode target = 1 resist_dispel = BIT1 parameter1 = (0 - 6) timing = 0 duration = 30 END
  END
BUT_ONLY

// True Creation normally produces permanent mundane matter chosen by the
// manifester. A generic item-construction UI is outside the SPL format, so the
// high-level creation is represented by a durable ectoplasmic construct.
LAF psion_create_level9_power
  STR_VAR
    ps_resref = ~PS9TCRE~
    ps_name = ~True Creation~
    ps_description = ~The Shaper creates a durable astral construct for ten turns. Tabletop True Creation makes a chosen nonmagical object permanently real; a portable SPL has no item-design or placement interface, so this version expresses high-level metacreativity through a long-lived construct instead.~
    ps_icon = ~spwi923~
END
COPY_EXISTING ~PS9TCRE.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 67 target = 1 timing = 1 duration = 600 STR_VAR resource = ~PSACON01~ END
BUT_ONLY

// Tornado Blast maps cleanly to area damage plus the wing-buffet opcode already
// used by lower-tier forced movement.
LAF psion_create_level9_power
  INT_VAR
    ps_target = 4
    ps_range = 60
    ps_projectile = IDS_OF_SYMBOL (~missile~ ~Fireball_Just_Projectile~)
    ps_flags = psion_level9_hostile_flags
  STR_VAR
    ps_resref = ~PS9TORN~
    ps_name = ~Tornado Blast~
    ps_description = ~A violent vortex deals 17d6 crushing damage in a large area, with a save vs breath for half, and hurls creatures that fail the save away from the center. The tabletop direct-hit 8d6 packet and random final displacement distance are not separately modeled.~
    ps_icon = ~spwi912~
END
COPY_EXISTING ~PS9TORN.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 12 target = 2 resist_dispel = BIT0 parameter2 = IDS_OF_SYMBOL (~dmgtype~ ~CRUSHING~) dicenumber = 17 dicesize = 6 savingthrow = BIT1 savebonus = psion_level9_save_penalty special = BIT8 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 238 target = 2 resist_dispel = BIT0 parameter1 = 8 savingthrow = BIT1 savebonus = psion_level9_save_penalty END
BUT_ONLY

// Greater Metamorphosis permits almost arbitrary forms. The portable release
// provides one very strong generalized form rather than unsafe CRE replacement.
LAF psion_create_level9_power
  STR_VAR
    ps_resref = ~PS9GMET~
    ps_name = ~Greater Metamorphosis~
    ps_description = ~For five rounds the Egoist assumes an apex mutable form, gaining +8 Strength and Constitution, +4 Dexterity, two extra attacks per round, +6 Armor Class, 40 percent physical resistance, and 50 percent faster movement. Tabletop Greater Metamorphosis can choose nearly any creature or object and change each round; arbitrary CRE replacement is not portable.~
    ps_icon = ~spwi916~
END
COPY_EXISTING ~PS9GMET.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 resist_dispel = BIT1 STR_VAR resource = ~PS9GMET~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 44 target = 1 resist_dispel = BIT1 parameter1 = 8 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 10 target = 1 resist_dispel = BIT1 parameter1 = 8 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 15 target = 1 resist_dispel = BIT1 parameter1 = 4 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 1 target = 1 resist_dispel = BIT1 parameter1 = 2 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 1 resist_dispel = BIT1 parameter1 = (0 - 6) timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 126 target = 1 resist_dispel = BIT1 parameter1 = 150 parameter2 = 2 timing = 0 duration = 30 END
  FOR (ps_resist_opcode = 86; ps_resist_opcode <= 89; ++ps_resist_opcode) BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = ps_resist_opcode target = 1 resist_dispel = BIT1 parameter1 = 40 timing = 0 duration = 30 END
  END
BUT_ONLY

// A persistent teleportation circle needs area placement and a destination UI.
// The portable form provides the strongest safe behavior already available:
// unrestricted relocation to a visible walkable point in the current area.
LAF psion_create_level9_power
  INT_VAR
    ps_target = 4
    ps_range = 0x7fff
    ps_projectile = psion_none_projectile
  STR_VAR
    ps_resref = ~PS9TCIR~
    ps_name = ~Teleportation Circle (Psionic)~
    ps_description = ~The Nomad teleports to any visible walkable point in the current area. Tabletop Teleportation Circle leaves a persistent portal that moves creatures to a designated distant destination; the engine needs a destination and persistent-area interface before that behavior can be represented safely.~
    ps_icon = ~spwi902~
END
COPY_EXISTING ~PS9TCIR.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 124 target = 1 resist_dispel = BIT1 parameter2 = 1 timing = 1 END
BUT_ONLY

// Psychic Chirurgery can heal psychic damage or teach powers. Runtime mutation
// of another actor's powers-known list is not yet implemented, so this version
// performs the restorative half and grants temporary mental protection.
LAF psion_create_level9_power
  INT_VAR
    ps_target = 2
    ps_range = 30
    ps_projectile = psion_none_projectile
  STR_VAR
    ps_resref = ~PS9PCHI~
    ps_name = ~Psychic Chirurgery~
    ps_description = ~The Telepath repairs severe psychic injury: removes level drain and grants +6 to all saving throws plus immunity to new charm and confusion effects for five rounds. Tabletop Psychic Chirurgery can also impart a known power; modifying another actor's permanent powers-known progression requires dedicated runtime support and is not simulated.~
    ps_icon = ~sppr909~
END
COPY_EXISTING ~PS9PCHI.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 224 target = 2 resist_dispel = BIT1 timing = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 2 resist_dispel = BIT1 STR_VAR resource = ~PS9PCHI~ END
  FOR (ps_save_opcode = 33; ps_save_opcode <= 37; ++ps_save_opcode) BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = ps_save_opcode target = 2 resist_dispel = BIT1 parameter1 = (0 - 6) timing = 0 duration = 30 END
  END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 resist_dispel = BIT1 parameter2 = 5 timing = 0 duration = 30 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 resist_dispel = BIT1 parameter2 = 128 timing = 0 duration = 30 END
BUT_ONLY
