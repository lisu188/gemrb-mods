BACKUP ~psion/backup~
AUTHOR ~lisu188~
VERSION ~1.3.0~
AUTO_EVAL_STRINGS
LANGUAGE ~English~ ~english~ ~psion/tra/english.tra~

BEGIN @0
DESIGNATED 0
REQUIRE_PREDICATE FILE_EXISTS ~gemrb_path.txt~ @1
REQUIRE_PREDICATE GAME_IS ~tutu tutu_totsc bgee ca bgt bg2ee eet~ @2

// Rules and runtime metadata.
COPY ~psion/tables/psionpool.2da~ ~override/psionpool.2da~
COPY ~psion/tables/psionknown.2da~ ~override/psionknown.2da~
COPY ~psion/tables/psiondisc.2da~ ~override/psiondisc.2da~
COPY ~psion/tables/psionskills.2da~ ~override/psionskills.2da~
COPY ~psion/tables/psskill.2da~ ~override/psskill.2da~
COPY ~psion/tables/psionfeats.2da~ ~override/psionfeats.2da~
COPY ~psion/tables/psionfeatpick.2da~ ~override/psionfeatpick.2da~
COPY ~psion/tables/psfsel.2da~ ~override/psfsel.2da~
COPY ~psion/tables/pspick.2da~ ~override/pspick.2da~
COPY ~psion/tables/psionpowers.2da~ ~override/psionpowers.2da~
COPY ~psion/tables/psionaugment.2da~ ~override/psionaugment.2da~
COPY ~psion/tables/ps1eray.2da~ ~override/ps1eray.2da~
COPY ~psion/tables/ps1mthr.2da~ ~override/ps1mthr.2da~
COPY ~psion/tables/ps1vigr.2da~ ~override/ps1vigr.2da~
COPY ~psion/tables/ps2swcr.2da~ ~override/ps2swcr.2da~
COPY ~psion/tables/ps2aaff.2da~ ~override/ps2aaff.2da~
COPY ~psion/tables/mxpsion.2da~ ~override/mxpsion.2da~

// CLABs provide the persistent class utility actions. Actual powers are learned
// through PXPLRN under the PSIONKNOWN.2DA allowance and maximum-tier limits.
// Center Mind is reusable; bonus-feat and skill-training selectors are re-enabled
// by runtime credits.
COPY ~psion/tables/clabpsee.2da~ ~override/clabpsee.2da~
COPY ~psion/tables/clabpsha.2da~ ~override/clabpsha.2da~
COPY ~psion/tables/clabpkin.2da~ ~override/clabpkin.2da~
COPY ~psion/tables/clabpego.2da~ ~override/clabpego.2da~
COPY ~psion/tables/clabpnom.2da~ ~override/clabpnom.2da~
COPY ~psion/tables/clabptel.2da~ ~override/clabptel.2da~

INCLUDE ~common/weidu/class-item-usability.tpa~
INCLUDE ~psion/lib/powers.tpa~

// Selector choices use harmless proxy SPLs so choosing a power to learn never
// manifests the real power for free. The proxies retain the real SPL UI metadata.
AT_NOW ~python3 "psion/tools/generate_learning_proxies.py" --override "override" --output ".psion-learn-build"~
COPY ~.psion-learn-build~ ~override~
AT_NOW ~python3 "psion/tools/generate_learning_proxies.py" --output ".psion-learn-build" --cleanup~

// The public power resources are authored against the guaranteed INT 15 minimum.
// Build internal copies for every other BG-family ability modifier that alter
// only save-bearing effects. Psionics.py substitutes the current-INT variant at
// cast time while keeping the canonical learned power and PP accounting intact.
AT_NOW ~python3 "psion/tools/generate_dc_variants.py" --override "override" --output ".psion-dc-build"~
COPY ~.psion-dc-build~ ~override~
AT_NOW ~python3 "psion/tools/generate_dc_variants.py" --output ".psion-dc-build" --cleanup~

INCLUDE ~psion/lib/class-detect.tpa~
INCLUDE ~psion/lib/class-strings.tpa~
INCLUDE ~psion/lib/class-saves.tpa~
INCLUDE ~psion/lib/class-layout.tpa~
INCLUDE ~psion/lib/class-progression.tpa~
INCLUDE ~psion/lib/class-common.tpa~
INCLUDE ~psion/lib/item-usability.tpa~
INCLUDE ~psion/lib/class-startup.tpa~
INCLUDE ~psion/lib/class-skills.tpa~

BEGIN ~Psion late item compatibility patch~
DESIGNATED 100
REQUIRE_COMPONENT ~psion/setup-psion.tp2~ ~0~ ~Install the main Psion component first.~
INCLUDE ~common/weidu/spell-functions.tpa~
INCLUDE ~common/weidu/class-item-usability.tpa~
INCLUDE ~psion/lib/class-detect.tpa~
INCLUDE ~psion/lib/item-usability.tpa~
