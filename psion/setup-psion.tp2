BACKUP ~psion/backup~
AUTHOR ~lisu188~
VERSION ~1.0.0~
AUTO_EVAL_STRINGS
LANGUAGE ~English~ ~english~ ~psion/tra/english.tra~

BEGIN @0
DESIGNATED 0
REQUIRE_PREDICATE FILE_EXISTS ~gemrb_path.txt~ @1
REQUIRE_PREDICATE GAME_IS ~tutu tutu_totsc bgee ca bgt bg2ee eet~ @2

// Rules and runtime metadata.
COPY ~psion/tables/psionpool.2da~ ~override/psionpool.2da~
COPY ~psion/tables/psionknown.2da~ ~override/psionknown.2da~
COPY ~psion/tables/psiondisc.2da~ ~override/psiondisc.2da~
COPY ~psion/tables/psionskills.2da~ ~override/psionskills.2da~
COPY ~psion/tables/psionfeats.2da~ ~override/psionfeats.2da~
COPY ~psion/tables/psionpowers.2da~ ~override/psionpowers.2da~
COPY ~psion/tables/psionaugment.2da~ ~override/psionaugment.2da~
COPY ~psion/tables/ps1eray.2da~ ~override/ps1eray.2da~
COPY ~psion/tables/ps1mthr.2da~ ~override/ps1mthr.2da~
COPY ~psion/tables/ps1vigr.2da~ ~override/ps1vigr.2da~
COPY ~psion/tables/ps2swcr.2da~ ~override/ps2swcr.2da~
COPY ~psion/tables/ps2aaff.2da~ ~override/ps2aaff.2da~
COPY ~psion/tables/mxpsion.2da~ ~override/mxpsion.2da~

// Fixed power selections through class level 20. Every discipline follows the
// 3-to-36 powers-known progression and gains its own discipline power whenever
// a new power tier unlocks, including tiers 6-9 at levels 11, 13, 15 and 17.
COPY ~psion/tables/clabpsee.2da~ ~override/clabpsee.2da~
COPY ~psion/tables/clabpsha.2da~ ~override/clabpsha.2da~
COPY ~psion/tables/clabpkin.2da~ ~override/clabpkin.2da~
COPY ~psion/tables/clabpego.2da~ ~override/clabpego.2da~
COPY ~psion/tables/clabpnom.2da~ ~override/clabpnom.2da~
COPY ~psion/tables/clabptel.2da~ ~override/clabptel.2da~

INCLUDE ~psion/lib/powers.tpa~
INCLUDE ~psion/lib/class-detect.tpa~
INCLUDE ~psion/lib/class-strings.tpa~
INCLUDE ~psion/lib/class-saves.tpa~
INCLUDE ~psion/lib/class-layout.tpa~
INCLUDE ~psion/lib/class-progression.tpa~
INCLUDE ~psion/lib/class-common.tpa~
INCLUDE ~psion/lib/item-usability.tpa~
INCLUDE ~psion/lib/class-startup.tpa~
INCLUDE ~psion/lib/class-skills.tpa~
