ACTION_IF FILE_EXISTS_IN_GAME ~thiefscl.2da~ THEN BEGIN
  OUTER_SET sm_pre_monk = 0
  COPY_EXISTING ~thiefscl.2da~ ~override~
    COUNT_2DA_COLS sm_pre_cols
    READ_2DA_ENTRIES_NOW ~sm_pre_table~ 1
    FOR (sm_pre_i = 0; sm_pre_i < (sm_pre_cols - 1); ++sm_pre_i) BEGIN
      READ_2DA_ENTRY_FORMER ~sm_pre_table~ 2 sm_pre_i sm_pre_name
      PATCH_IF (~%sm_pre_name%~ STRING_EQUAL_CASE ~MONK~) BEGIN SET sm_pre_monk += 1 END
    END
  BUT_ONLY
  ACTION_IF sm_pre_monk != 1 THEN BEGIN FAIL @31 END

  OUTER_SET sm_pre_monk = 0
  COPY_EXISTING ~thiefskl.2da~ ~override~
    COUNT_2DA_COLS sm_pre_cols
