// Reject ambiguous component metadata before deriving Sorcerer/Monk policy.
// Count row/header identity independently of value validity so a malformed
// duplicate cannot be hidden by a later valid row.
OUTER_SET sm_pre_sorcerer = 0
OUTER_SET sm_pre_monk = 0

COPY_EXISTING ~clskills.2da~ ~override~
  COUNT_2DA_COLS sm_pre_cols
  READ_2DA_ENTRIES_NOW ~sm_pre_table~ sm_pre_cols
  FOR (sm_pre_i = 0; sm_pre_i < sm_pre_table; ++sm_pre_i) BEGIN
    READ_2DA_ENTRY_FORMER ~sm_pre_table~ sm_pre_i 0 sm_pre_name
    PATCH_IF (~%sm_pre_name%~ STRING_EQUAL_CASE ~SORCERER~) BEGIN
      SET sm_pre_sorcerer += 1
    END
    PATCH_IF (~%sm_pre_name%~ STRING_EQUAL_CASE ~MONK~) BEGIN
      SET sm_pre_monk += 1
    END
  END
BUT_ONLY
ACTION_IF (sm_pre_sorcerer != 1) OR (sm_pre_monk != 1) THEN BEGIN FAIL @31 END

ACTION_IF FILE_EXISTS_IN_GAME ~xpcap.2da~ THEN BEGIN
  OUTER_SET sm_pre_sorcerer = 0
  OUTER_SET sm_pre_monk = 0
  COPY_EXISTING ~xpcap.2da~ ~override~
    COUNT_2DA_COLS sm_pre_cols
    READ_2DA_ENTRIES_NOW ~sm_pre_table~ sm_pre_cols
    FOR (sm_pre_i = 0; sm_pre_i < sm_pre_table; ++sm_pre_i) BEGIN
      READ_2DA_ENTRY_FORMER ~sm_pre_table~ sm_pre_i 0 sm_pre_name
      PATCH_IF (~%sm_pre_name%~ STRING_EQUAL_CASE ~SORCERER~) BEGIN SET sm_pre_sorcerer += 1 END
      PATCH_IF (~%sm_pre_name%~ STRING_EQUAL_CASE ~MONK~) BEGIN SET sm_pre_monk += 1 END
    END
  BUT_ONLY
  ACTION_IF (sm_pre_sorcerer != 1) OR (sm_pre_monk != 1) THEN BEGIN FAIL @31 END
END

