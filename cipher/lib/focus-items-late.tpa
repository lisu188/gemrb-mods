// Reapply Cipher Focus-on-hit support to items introduced after the main
// component. The shared patch function is idempotent, so existing attack
// headers remain unchanged.
//
// SPLPROT.2DA is the authoritative installed registry for opcode 326 target
// filters. Resolve CIPHER_HOSTILE by its row name instead of reverse-engineering
// an effect from CIFCRIT.SPL: this remains correct if another mod appends rows
// after Cipher and avoids depending on a generated SPL's internal layout.

OUTER_SET ci_hostile_splprot = (0 - 1)
OUTER_SET ci_hostile_splprot_matches = 0
COPY_EXISTING ~splprot.2da~ ~override~
  COUNT_2DA_COLS ci_late_splprot_cols
  COUNT_2DA_ROWS ci_late_splprot_cols ci_late_splprot_rows
  FOR (ci_late_splprot_row = 0; ci_late_splprot_row < ci_late_splprot_rows; ++ci_late_splprot_row) BEGIN
    READ_2DA_ENTRY ci_late_splprot_row 0 ci_late_splprot_cols ci_late_splprot_name
    PATCH_IF ~%ci_late_splprot_name%~ STRING_EQUAL_CASE ~CIPHER_HOSTILE~ BEGIN
      INNER_ACTION BEGIN
        OUTER_SET ci_hostile_splprot = ci_late_splprot_row
        OUTER_SET ci_hostile_splprot_matches = ci_hostile_splprot_matches + 1
      END
    END
  END
BUT_ONLY

ACTION_IF ci_hostile_splprot_matches != 1 THEN BEGIN
  FAIL ~The Cipher late item patch requires exactly one CIPHER_HOSTILE row in SPLPROT.2DA.~
END

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
  LPF CIPHER_ADD_FOCUS_HIT_EFFECT END
BUT_ONLY
