// Reapply Cipher Focus-on-hit support to items introduced after the main
// component. The shared patch function is idempotent, so existing attack
// headers remain unchanged.
//
// Component 0 persists the exact numeric CIPHER_HOSTILE SPLPROT row when it
// creates that row. WeiDU excludes the row label from COUNT_2DA_COLS, so this
// private table is deliberately validated as one data column and one data row.

OUTER_SET ci_hostile_splprot = (0 - 1)
OUTER_SET ci_focus_metadata_valid = 0
COPY_EXISTING ~cipherfocus.2da~ ~override~
  COUNT_2DA_COLS ci_focus_metadata_cols
  COUNT_2DA_ROWS ci_focus_metadata_cols ci_focus_metadata_rows
  PATCH_IF (ci_focus_metadata_cols = 1) AND (ci_focus_metadata_rows = 1) BEGIN
    READ_2DA_ENTRY 0 0 ci_focus_metadata_cols ci_focus_metadata_value
    INNER_ACTION BEGIN
      OUTER_SET ci_hostile_splprot = ci_focus_metadata_value
      OUTER_SET ci_focus_metadata_valid = 1
    END
  END
BUT_ONLY

ACTION_IF (ci_focus_metadata_valid != 1) OR (ci_hostile_splprot < 0) THEN BEGIN
  FAIL ~The Cipher late item patch could not recover CIPHER_HOSTILE metadata from CIPHERFOCUS.2DA.~
END

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
  LPF CIPHER_ADD_FOCUS_HIT_EFFECT END
BUT_ONLY
