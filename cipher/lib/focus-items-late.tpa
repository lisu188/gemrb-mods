// Reapply Cipher Focus-on-hit support to items introduced after the main
// component. The shared patch function is idempotent, so existing attack
// headers remain unchanged.
//
// Component 0 persists the exact numeric CIPHER_HOSTILE SPLPROT row when it
// creates that row. CIPHERFOCUS.2DA is a private one-cell contract, so read the
// single data entry directly and explicitly evaluate the textual 2DA value as
// an integer before exporting it from patch scope.

OUTER_SET ci_hostile_splprot = (0 - 1)
COPY_EXISTING ~cipherfocus.2da~ ~override~
  READ_2DA_ENTRY 0 0 1 ci_focus_metadata_value
  INNER_ACTION BEGIN
    OUTER_SET ci_hostile_splprot = EVALUATE_BUFFER ~%ci_focus_metadata_value%~
  END
BUT_ONLY

ACTION_IF ci_hostile_splprot <= 0 THEN BEGIN
  FAIL ~The Cipher late item patch could not recover CIPHER_HOSTILE metadata from CIPHERFOCUS.2DA.~
END

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
  LPF CIPHER_ADD_FOCUS_HIT_EFFECT END
BUT_ONLY
