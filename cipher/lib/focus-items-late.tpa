// Reapply Cipher Focus-on-hit support to items introduced after the main
// component. The shared patch function is idempotent, so existing attack
// headers remain unchanged.

OUTER_SET ci_hostile_splprot = (0 - 1)
OUTER_SET ci_meta_version = 0
COPY_EXISTING ~cifmeta.2da~ ~override~
  COUNT_2DA_COLS ci_meta_cols
  READ_2DA_ENTRY 1 0 ci_meta_cols ci_hostile_splprot_text
  READ_2DA_ENTRY 2 0 ci_meta_cols ci_meta_version_text
  INNER_ACTION BEGIN
    OUTER_SET ci_hostile_splprot = %ci_hostile_splprot_text%
    OUTER_SET ci_meta_version = %ci_meta_version_text%
  END
BUT_ONLY

ACTION_IF ci_meta_version != 1 THEN BEGIN
  FAIL ~The Cipher late item patch found an unsupported CIFMETA.2DA format.~
END

ACTION_IF ci_hostile_splprot < 0 THEN BEGIN
  FAIL ~The Cipher late item patch could not recover the CIPHER_HOSTILE SPLPROT row.~
END

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
  LPF CIPHER_ADD_FOCUS_HIT_EFFECT END
BUT_ONLY
