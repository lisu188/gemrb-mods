DEFINE_ACTION_FUNCTION cipher_create_internal_spell
STR_VAR
  ci_resref = ~~
BEGIN
  CREATE ~spl~ ~%ci_resref%~
  COPY_EXISTING ~%ci_resref%.spl~ ~override~
    WRITE_SHORT 0x1c 4
    WRITE_LONG 0x18 (BIT14 BOR BIT25)
    WRITE_LONG 0x34 1
    LPF ADD_SPELL_HEADER
      INT_VAR target = 5 range = 0x7fff speed = 0 projectile = 1
      STR_VAR icon = ~~
    END
  BUT_ONLY
END

OUTER_SET ci_splprot_rows = 0
COPY_EXISTING ~splprot.2da~ ~override~
  COUNT_2DA_COLS ci_splprot_cols
  COUNT_2DA_ROWS ci_splprot_cols ci_splprot_count
  SPRINT ci_splprot_prefix ~~
  READ_ASCII (BUFFER_LENGTH - 1) ci_splprot_last (1)
  PATCH_IF NOT (~%ci_splprot_last%~ STRING_EQUAL ~%LNL%~) BEGIN
    SPRINT ci_splprot_prefix ~%LNL%~
  END
  SPRINT ci_splprot_append ~%ci_splprot_prefix%CIPHER_CLASS 0x10d %ci_class_id% 1%LNL%CIPHER_HOSTILE 0x108 2 1%LNL%~
  FOR (ci_unit = 0; ci_unit < 34; ++ci_unit) BEGIN
    SPRINT ci_splprot_append ~%ci_splprot_append%CIPHER_FOCUS_%ci_unit% 165 %ci_unit% 1%LNL%~
  END
  SET ci_splprot_offset = BUFFER_LENGTH
  SET ci_splprot_length = STRING_LENGTH ~%ci_splprot_append%~
  INSERT_BYTES ci_splprot_offset ci_splprot_length
  WRITE_ASCIIE ci_splprot_offset ~%ci_splprot_append%~
  INNER_ACTION BEGIN OUTER_SET ci_splprot_rows = ci_splprot_count END
BUT_ONLY

OUTER_SET ci_class_splprot = ci_splprot_rows
OUTER_SET ci_hostile_splprot = ci_splprot_rows + 1

// Every setter owns one permanent ScriptingState effect. Before installing the
// next state it removes every previous CIFS<n> parent resource. Timing mode 9
// keeps the current Focus state in the actor effect queue, so normal CRE
// save/load serialization preserves Focus without relying on a GUI-only stat.
OUTER_FOR (ci_unit = 0; ci_unit <= 34; ++ci_unit) BEGIN
  OUTER_SPRINT ci_setter ~CIFS%ci_unit%~
  LAF cipher_create_internal_spell STR_VAR ci_resref = ~%ci_setter%~ END
  COPY_EXISTING ~%ci_setter%.spl~ ~override~
    FOR (ci_old_unit = 0; ci_old_unit <= 34; ++ci_old_unit) BEGIN
      SPRINT ci_old_setter ~CIFS%ci_old_unit%~
      LPF ADD_SPELL_EFFECT
        INT_VAR opcode = 321 target = 1 timing = 1 parameter2 = 0
        STR_VAR resource = ~%ci_old_setter%~
      END
    END
    LPF ADD_SPELL_EFFECT
      INT_VAR opcode = 282 target = 1 timing = 9 parameter1 = ci_unit parameter2 = 9
      STR_VAR resource = ~CIFOCUS~
    END
  BUT_ONLY
END

LAF cipher_create_internal_spell STR_VAR ci_resref = ~CIFSTEP~ END
COPY_EXISTING ~CIFSTEP.spl~ ~override~
  FOR (ci_unit = 33; ci_unit >= 0; --ci_unit) BEGIN
    SET ci_row = ci_splprot_rows + 2 + ci_unit
    SET ci_next = ci_unit + 1
    SPRINT ci_setter ~CIFS%ci_next%~
    LPF ADD_SPELL_EFFECT
      INT_VAR opcode = 326 target = 1 timing = 1 parameter2 = ci_row
      STR_VAR resource = ~%ci_setter%~
    END
  END
BUT_ONLY

LAF cipher_create_internal_spell STR_VAR ci_resref = ~CIFGAIN~ END
COPY_EXISTING ~CIFGAIN.spl~ ~override~
  LPF ADD_SPELL_EFFECT
    INT_VAR opcode = 326 target = 1 timing = 1 parameter2 = ci_class_splprot
    STR_VAR resource = ~CIFSTEP~
  END
BUT_ONLY

DEFINE_PATCH_FUNCTION CIPHER_ADD_FOCUS_HIT_EFFECT
BEGIN
  PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
    READ_ASCII 0 ci_signature (8)
    PATCH_IF ~%ci_signature%~ STRING_EQUAL_CASE ~ITM V1  ~ BEGIN
      READ_LONG 0x64 ci_header_offset
      READ_SHORT 0x68 ci_header_count
      READ_LONG 0x6a ci_effect_offset
      READ_SHORT 0x6e ci_equipping_index
      READ_SHORT 0x70 ci_equipping_count

      FOR (ci_header_index = 0; ci_header_index < ci_header_count; ++ci_header_index) BEGIN
        SET ci_header = ci_header_offset + (ci_header_index * 0x38)
        READ_BYTE ci_header ci_attack_type
        READ_BYTE (ci_header + 0x02) ci_location
        PATCH_IF (ci_location = 1)
          AND ((ci_attack_type = 1) OR (ci_attack_type = 2) OR (ci_attack_type = 3)) BEGIN
          READ_SHORT (ci_header + 0x1e) ci_effect_count
          READ_SHORT (ci_header + 0x20) ci_first_effect
          SET ci_new_index = ci_first_effect + ci_effect_count
          SET ci_new_effect = ci_effect_offset + (ci_new_index * 0x30)
          INSERT_BYTES ci_new_effect 0x30

          // ApplyEffectsList checks the struck target against the caster using
          // CIPHER_HOSTILE. When it matches, CIFGAIN is applied with the weapon
          // user as the spell caster; CIFGAIN's self-targeted effects therefore
          // advance Focus on the attacker rather than on the victim.
          WRITE_SHORT ci_new_effect 326
          WRITE_BYTE (ci_new_effect + 0x02) 2
          WRITE_LONG (ci_new_effect + 0x04) 0
          WRITE_LONG (ci_new_effect + 0x08) ci_hostile_splprot
          WRITE_BYTE (ci_new_effect + 0x0c) 1
          WRITE_ASCIIE (ci_new_effect + 0x14) ~CIFGAIN~ #8
          WRITE_SHORT (ci_header + 0x1e) (ci_effect_count + 1)

          FOR (ci_other = ci_header_index + 1; ci_other < ci_header_count; ++ci_other) BEGIN
            SET ci_other_header = ci_header_offset + (ci_other * 0x38)
            READ_SHORT (ci_other_header + 0x20) ci_other_first
            WRITE_SHORT (ci_other_header + 0x20) (ci_other_first + 1)
          END

          PATCH_IF (ci_equipping_count > 0) AND (ci_new_index <= ci_equipping_index) BEGIN
            SET ci_equipping_index = ci_equipping_index + 1
            WRITE_SHORT 0x6e ci_equipping_index
          END
        END
      END
    END
  END
END

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
  LPF CIPHER_ADD_FOCUS_HIT_EFFECT END
BUT_ONLY
