BACKUP ~cipher/backup~
AUTHOR ~lisu188~
VERSION ~0.3.0~
AUTO_EVAL_STRINGS

LANGUAGE ~English~ ~english~ ~cipher/tra/english.tra~

BEGIN @0
DESIGNATED 0
REQUIRE_PREDICATE FILE_EXISTS ~gemrb_path.txt~ @1
REQUIRE_PREDICATE GAME_IS ~tutu tutu_totsc bgee ca bgt bg2ee eet~ @2

COPY ~cipher/tables/cipherpowers.2da~ ~override/cipherpowers.2da~
COPY ~cipher/tables/cipherknown.2da~ ~override/cipherknown.2da~
COPY ~cipher/tables/cipick.2da~ ~override/cipick.2da~
COPY ~cipher/tables/cisubpck.2da~ ~override/cisubpck.2da~
COPY ~cipher/tables/clabciph.2da~ ~override/clabciph.2da~
COPY ~cipher/tables/mxcipher.2da~ ~override/mxcipher.2da~

INCLUDE ~common/weidu/spell-functions.tpa~
INCLUDE ~common/weidu/class-item-usability.tpa~
INCLUDE ~cipher/lib/focus-item-patch.tpa~
INCLUDE ~cipher/lib/class.tpa~
INCLUDE ~cipher/lib/class-skills-fix.tpa~
INCLUDE ~cipher/lib/class-thac0-fix.tpa~
INCLUDE ~cipher/lib/powers.tpa~
INCLUDE ~cipher/lib/power-learning.tpa~
INCLUDE ~cipher/lib/power-thac0-fix.tpa~
INCLUDE ~cipher/lib/soul-whip-fix.tpa~
INCLUDE ~cipher/lib/high-tier-fidelity.tpa~
INCLUDE ~cipher/lib/combat-fidelity.tpa~

AT_NOW ~python "cipher/tools/generate_learning_proxies.py" --override "override" --output ".cipher-learn-build"~
COPY ~.cipher-learn-build~ ~override~
AT_NOW ~python "cipher/tools/generate_learning_proxies.py" --output ".cipher-learn-build" --cleanup~

INCLUDE ~cipher/lib/focus.tpa~
INCLUDE ~cipher/lib/focus-core.tpa~
INCLUDE ~cipher/lib/critical-focus.tpa~
INCLUDE ~cipher/lib/reaping-knives.tpa~
INCLUDE ~cipher/lib/subclasses.tpa~
INCLUDE ~cipher/lib/item-usability.tpa~

BEGIN ~Cipher late item compatibility patch~
DESIGNATED 100
REQUIRE_COMPONENT ~cipher/setup-cipher.tp2~ ~0~ ~Install the main Cipher component first.~
OUTER_SET ci_class_id = IDS_OF_SYMBOL (~class~ ~CIPHER~)
ACTION_IF ci_class_id < 0 THEN BEGIN
  FAIL ~The Cipher late item patch could not recover the CIPHER class ID.~
END
INCLUDE ~common/weidu/class-item-usability.tpa~
INCLUDE ~cipher/lib/focus-item-patch.tpa~
INCLUDE ~cipher/lib/focus-items-late.tpa~
INCLUDE ~cipher/lib/item-usability.tpa~
